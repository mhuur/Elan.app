# Configuration Firebase — copiez ce fichier en `.env` et remplissez les valeurs
# trouvées dans la console Firebase : Paramètres du projet > Vos applications > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Synchro Strava → Élan (optionnel) : URL du Worker Cloudflare (voir worker/README.md).
# Tant que VITE_STRAVA_SYNC_URL est vide, le bouton « Synchroniser » reste masqué.
VITE_STRAVA_SYNC_URL=
VITE_STRAVA_SYNC_KEY=
