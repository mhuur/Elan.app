# Configuration Firebase — copiez ce fichier en `.env` et remplissez les valeurs
# trouvées dans la console Firebase : Paramètres du projet > Vos applications > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Synchro Strava → Élan (optionnel) : URL du Worker Cloudflare (voir worker/README.md).
# Tant que VITE_STRAVA_SYNC_URL est vide, le bouton « Synchroniser » reste masqué.
VITE_STRAVA_SYNC_URL=
VITE_STRAVA_SYNC_KEY=

# Rappels de séance par notification (optionnel) : URL du Worker `elan-notif`
# (voir worker/notif/README.md). Tant qu'elle est vide, le bloc « Rappels » des
# Réglages reste masqué.
VITE_NOTIF_URL=
# Clé partagée anti-abus léger (non secrète : embarquée dans l'app, comme celle de Strava).
VITE_NOTIF_KEY=

# Clé publique VAPID — `node scripts/generate-vapid.mjs` la génère et l'écrit dans .env.
# Publique par nature : elle est embarquée dans le bundle (`applicationServerKey`).
VITE_VAPID_PUBLIC_KEY=

# La clé PRIVÉE correspondante (VAPID_PRIVATE_KEY, sans préfixe VITE_) reste dans .env
# et ne part JAMAIS dans le bundle. Elle se pose en secret sur le Worker :
#   cd worker/notif && npx wrangler secret put VAPID_PRIVATE_KEY
